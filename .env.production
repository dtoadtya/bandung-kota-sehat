#--------------------------------------------------------------------
# PRODUCTION ENVIRONMENT — https://bandungsehat.my.id
#
# On the server: rename/copy this file to ".env", then fill in
# the database credentials from your hosting control panel.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://bandungsehat.my.id/'
app.forceGlobalSecureRequests = true

# Remove index.php from URLs (requires mod_rewrite, already enabled
# in public/.htaccess). Set back to 'index.php' if links break.
app.indexPage = ''

#--------------------------------------------------------------------
# COOKIE (HTTPS)
#--------------------------------------------------------------------

cookie.secure = true
cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# DATABASE — fill in from your hosting panel (phpMyAdmin / cPanel)
#--------------------------------------------------------------------

database.default.hostname = 'localhost'
database.default.database = 'YOUR_DB_NAME'
database.default.username = 'YOUR_DB_USER'
database.default.password = 'YOUR_DB_PASSWORD'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION KEY — run on the server: php spark key:generate
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 4
